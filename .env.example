DATABASE_URL=postgresql+psycopg://economy:change-me@localhost:5432/economy
POSTGRES_DB=economy
POSTGRES_USER=economy
POSTGRES_PASSWORD=change-me
# Comma-separated name=token pairs. Replace each placeholder with a unique, strong token.
# Tokens must not contain commas.
API_CLIENTS=api-key-1=replace-with-a-strong-token,casino-bot=replace-with-another-strong-token,first-aegean-bank=replace-with-a-strong-token,account-admin=replace-with-an-admin-token,default-read=default_read
# Comma-separated client names that may only access read endpoints.
API_READ_ONLY_CLIENTS=default-read
# High-impact account merge/recovery operations are limited to these clients.
API_ADMIN_CLIENTS=account-admin,first-aegean-bank
TOKEN_PRICE=10
CHALLENGE_FEE_ENABLED=true
CHALLENGE_FEE_PERCENT=5
LOG_LEVEL=INFO
